// 비밀 값(GH_OAUTH_CLIENT_ID/SECRET)은 여기에 두지 않는다. `wrangler secret put` 이나 CI 가 넣는다.
// database_id 는 자리 표시자다. CI(deploy.yml 의 worker-deploy)가 배포 직전에 실제 값으로 바꾼다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comments",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    // 운영에는 사이트 출처만 둔다. localhost 를 두면 운영 워커가 방문자의 localhost:4321 에서 오는 쓰기를 받고,
    // /v1/auth/start?origin=http://localhost:4321 이 새 세션 토큰을 그 주소로 넘긴다(WB-review). 로컬은 env.test 를 쓴다.
    "ALLOWED_ORIGINS": "https://bigsaigon333.github.io",
    "MODE": "readwrite",
    // 소유자의 GitHub 숫자 id 는 공개 정보라 var 로 둔다(CI 는 GH_OAUTH_* 두 secret 만 올린다).
    "OWNER_GITHUB_ID": "31029000",
    "SITE_URL": "https://bigsaigon333.github.io",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comments",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    // 로컬 시험용: `npx wrangler dev --env test`. 운영에 배포하지 않는다.
    "test": {
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321",
        "MODE": "readwrite",
        "OWNER_GITHUB_ID": "1",
        "SITE_URL": "",
        "TEST_LOGIN": "1",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "comments-test",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
