{
  "name": "bigsaigon333.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "tools/astro-check"
  ],
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro sync && tools/astro-check/node_modules/.bin/astro-check",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro sync && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "verify": "node scripts/verify/run.mjs",
    "verify:setup": "node scripts/verify/setup.mjs",
    "verify:selftest": "node scripts/verify/selftest.mjs",
    "verify:live": "node scripts/verify/live.mjs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.8",
    "astro": "^7.4.11",
    "highlight.js": "11.5.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2"
  }
}
