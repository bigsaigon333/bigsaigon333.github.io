---
import CategoryLink from "./CategoryLink.astro";

// 글 머리 위의 카테고리 배지 한 줄(/categories/<slug> 로 가는 링크).
interface Props {
  /** frontmatter 의 category("개발"). */
  name: string;
}
---

<p class="post-category">
  <CategoryLink name={Astro.props.name} badge />
</p>

<style>
  .post-category {
    margin: 0 0 calc(-1 * var(--space-4));
  }
</style>
