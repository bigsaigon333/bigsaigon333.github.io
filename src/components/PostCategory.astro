---
import { categoryByName, categoryPath } from "../lib/categories";

// 글 머리 위의 카테고리 링크 한 줄(/categories/<slug>). 모양은 웨이브 B 에서 다듬는다.
interface Props {
  /** frontmatter 의 category("개발"). */
  name: string;
}

const category = categoryByName(Astro.props.name);
---

<p class="post-category">
  <a href={categoryPath(category)}>{category.name}</a>
</p>

<style>
  .post-category {
    margin: 0;
  }

  .post-category a {
    text-decoration: underline;
  }
</style>
