---
// Google Analytics(gtag.js). 레이아웃이 <head> 안에서 한 번 렌더한다.
//
// 두 스크립트 모두 is:inline 이다. Astro 가 번들하면 type="module" 이 붙어 실행이 문서 파싱 뒤로 밀리고,
// 외부 URL 인 로더는 애초에 번들 대상이 아니다. 구글이 안내하는 스니펫처럼 쓴 자리에서 쓴 대로 나가야 한다.
//
// 측정 ID 는 아래 gtagScript 가 define:vars 와 같은 모양으로 넣는다:
//   (function(){ const gaId = "G-…"; … })();
// 안에서 선언한 함수는 전역이 되지 않으므로, 예전 사이트처럼 전역 gtag() 가 남도록 window 에 직접 단다.
//
// CSP(S7.2): Astro 는 is:inline 스크립트의 해시를 모른다. inlineScript() 가 이 글자 그대로의 sha256 을 정책에 넣는다.
// 로더는 외부 파일이라 해시가 아니라 출처(https://*.googletagmanager.com)로 허용한다(config/csp.mjs).
//
// View Transitions(S6.2): <ClientRouter /> 로 옮겨 가면 문서가 다시 로드되지 않는다. <head> 의 이 두 스크립트는
// 다음 페이지에도 글자 그대로 있으므로 라우터가 다시 실행하지 않는다(로더도, config 도 한 번). 첫 페이지의
// page_view 는 config 가 보내고, 그 뒤의 페이지는 gtag.js 가 센다: GA4 웹 스트림의 향상된 측정
// "브라우저 기록 이벤트 기반 페이지 변경"이 켜져 있어, 라우터의 pushState·popstate 를 보고 바뀐 주소와 <title> 로
// page_view 를 하나씩 보낸다(뒤로·앞으로 포함). 그래서 여기서는 page_view 를 직접 보내지 않는다(W9).
// 예전에는 astro:after-swap 에서 하나를 더 보내 옮겨 갈 때마다 두 번 세어졌다(실제 gtag.js 로 /g/collect 확인).
// 처음의 dataLayer 는 예전과 같다: js, config(embeds 검사가 기준선과 비교한다). navigation 검사는 옮겨 간 뒤에도
// dataLayer 의 page_view 가 config 하나뿐인지 본다.
// (is:inline 스크립트 안의 주석은 모든 페이지의 HTML 에 그대로 실리므로 설명은 여기에 적는다.)
import { inlineScript } from "../../config/csp.mjs";
import { SITE } from "../lib/site";

const { gaId } = SITE;

const gtagScript = inlineScript(
  Astro,
  `(function(){const gaId = ${JSON.stringify(gaId)};

window.dataLayer = window.dataLayer || [];
window.gtag = function gtag() {
  dataLayer.push(arguments);
};
gtag("js", new Date());

gtag("config", gaId);
})();`,
);
---

<script
  is:inline
  async
  src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
></script>
<script is:inline set:html={gtagScript} />
