---
import { SITE } from "../lib/site";

// 페이지마다 달라지는 값만 받는다. 작성자·og:image·twitter:card 는 사이트 전체가 같아서 SITE 에서 읽는다.
export interface Props {
  title: string;
  description: string;
  url: string;
  type: "website" | "article";
  keywords: string[];
  /** 글의 발행일. 글 페이지만 준다 → article:published_time, JSON-LD 의 datePublished. */
  publishedTime?: Date;
  /** 검색 결과에 나오면 안 되는 페이지(404)만 true. */
  noindex?: boolean;
}

const {
  title,
  description,
  url,
  type,
  keywords,
  publishedTime,
  noindex = false,
} = Astro.props;

const isArticle = type === "article";
// 글의 date 는 날짜뿐이라 시각은 UTC 자정이 된다. PostHeader 의 <time datetime> 과 같은 값이다.
const published = publishedTime?.toISOString();

// index, follow 는 적지 않아도 기본값이다(구글 문서에는 규칙으로 실려 있지도 않다). 의도가 보이도록 적어 둔다.
// max-* 는 검색 결과에서 큰 이미지 미리보기와 길이 제한 없는 스니펫을 허락한다.
const robots = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// 구조화 데이터(JSON-LD). 글은 BlogPosting, 홈은 WebSite, 그 밖의 페이지(404)는 없다.
// 구글은 WebSite 를 홈에서만 읽으므로 "canonical 이 사이트 주소인 페이지"일 때만 낸다.
const author = { "@type": "Person", name: SITE.author, url: SITE.github };
const structuredData = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      // 빈 값은 키째로 뺀다(undefined 는 JSON.stringify 가 떨어뜨린다).
      description: description || undefined,
      datePublished: published,
      author,
      image: SITE.ogImage,
      url,
      mainEntityOfPage: { "@type": "WebPage", "@id": url },
      inLanguage: SITE.lang,
      keywords: keywords.length > 0 ? keywords : undefined,
    }
  : url === SITE.url
    ? {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE.title,
        url: SITE.url,
        description: SITE.description,
        inLanguage: SITE.lang,
        author,
      }
    : null;

// set:html 은 이스케이프하지 않는다. 제목에 "</script>" 가 들어 있으면 거기서 스크립트가 끝나 버리므로
// "<" 를 JSON 의 유니코드 이스케이프로 바꾼다. JSON.parse 하면 원래 문자로 돌아온다.
const jsonLd =
  structuredData && JSON.stringify(structuredData).replace(/</g, "\\u003c");

// 아래 템플릿에서 지킬 순서: og:image:* 는 자기가 꾸미는 og:image 바로 뒤에 둔다. Open Graph 는 태그를 순서대로 읽어
// 직전에 나온 og:image 에 붙인다. 템플릿에 HTML 주석으로 적으면 모든 페이지에 실리므로 여기에 적는다.
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<meta name="keywords" content={keywords.join(", ")} />
<meta name="robots" content={robots} />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={url} />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.title}
  href={`${SITE.url}/rss.xml`}
/>

<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:type" content={type} />
<meta property="og:image" content={SITE.ogImage} />
<meta property="og:image:type" content={SITE.ogImageType} />
<meta property="og:image:width" content={String(SITE.ogImageWidth)} />
<meta property="og:image:height" content={String(SITE.ogImageHeight)} />
<meta property="og:image:alt" content={SITE.ogImageAlt} />
{isArticle && published && (
  <meta property="article:published_time" content={published} />
)}
{isArticle &&
  keywords.map((keyword) => <meta property="article:tag" content={keyword} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={SITE.ogImage} />
<meta name="twitter:image:alt" content={SITE.ogImageAlt} />

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
