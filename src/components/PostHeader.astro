---
import { formatDate } from "../lib/posts";

// 글의 제목과 날짜. 글 페이지의 머리와 홈 목록의 항목이 같은 모양이라 함께 쓴다.
interface Props {
  title: string;
  date: Date;
  /** 주면 제목이 이 주소로 가는 링크가 된다(홈 목록). */
  href?: string;
}

const { title, date, href } = Astro.props;
---

<article>
  {href ? (
    <a href={href}>
      <h2>{title}</h2>
    </a>
  ) : (
    <h2>{title}</h2>
  )}
  <time datetime={date.toISOString()}>{formatDate(date)}</time>
</article>

<style>
  /* pages/index.style.ts 의 Article */
  article h2 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem;
    font-weight: 800;
  }

  @media (max-width: 600px) {
    article h2 {
      font-size: 2rem;
    }
  }

  @media (max-width: 375px) {
    article h2 {
      font-size: 1.5rem;
    }
  }

  article time {
    font-size: 1rem;
  }

  /* 배포본에서도 맞는 요소가 없는 규칙이다(article 안에 p 가 없다). 그대로 옮겼다. */
  article p {
    font-size: 1.25rem;
    line-height: 1.75rem;
  }
</style>
