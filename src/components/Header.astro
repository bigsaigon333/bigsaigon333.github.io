---
import { Picture } from "astro:assets";

import profile from "../assets/profile.jpg";
import { SITE } from "../lib/site";

// 프로필 사진: astro:assets 가 빌드 때 webp·jpg 를 너비 3개로 만든다.
// avif 도 더하면 더 작지만(192w 3.6KB, webp 6.3KB) <source> 가 하나 늘어 예전 마크업(webp source + jpg img)과 모양이 달라진다.
// 상자 크기는 .profile-wrapper 가 정하고 img 는 그 상자를 채우므로(아래 .profile) 렌더 크기는 그대로다.
// public/profile.jpg·profile.webp 는 예전 주소로 들어오는 요청을 위해 남긴다.

interface Props {
  /** 홈에서만 메일·깃허브 아이콘 링크를 보여 준다. */
  home?: boolean;
}

const { home = false } = Astro.props;
---

<header>
  <h1 class="title">
    <a class="title-link" href="/">
      <div class="profile-wrapper">
        <Picture
          class="profile"
          src={profile}
          alt="프로필"
          formats={["webp"]}
          widths={[192, 384, profile.width]}
          sizes="(max-width: 600px) 20vw, (max-width: 767px) 25vw, 192px"
          loading="eager"
        />
      </div>
      <div>
        <span>프론트엔드 개발자</span>
        <br />
        <span>김동희입니다</span>
      </div>
    </a>
  </h1>

  {home && (
    <ul class="link-list">
      <li>
        <a
          class="email-link"
          href={`mailto:${SITE.email}`}
          aria-label="김동희에게 메일 보내기"
          referrerpolicy="no-referrer"
          target="_blank"
        />
      </li>
      <li>
        <a
          class="github-link"
          href={SITE.github}
          aria-label="김동희 깃허브"
          referrerpolicy="no-referrer"
          target="_blank"
        />
      </li>
    </ul>
  )}
</header>

<style>
  /* components/header.style.ts 를 옮긴 것. 주석은 예전 styled-component 이름이다. */

  /* Container */
  header {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  /* Title */
  .title {
    margin: 0;
    line-height: 1.25;
    width: 100%;
    font-weight: 800;
  }

  /* A */
  .title-link {
    width: 100%;
    font-size: 3.6rem;
    text-align: center;
    display: flex;
    column-gap: 2rem;
    justify-content: center;
    align-items: center;
  }

  /* 배포본에서도 맞는 요소가 없는 규칙이다(제목은 p 가 아니라 div 안에 있다). 그대로 옮겼다. */
  .title-link:hover p span {
    box-shadow: 0 0.25rem 0 0 black;
  }

  @media (max-width: 767px) {
    .title-link {
      font-size: 9vw;
      column-gap: 1rem;
    }
  }

  /* ProfileWrapper */
  .profile-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 35%;
    width: 25%;
    padding-bottom: 25%;
  }

  @media (max-width: 600px) {
    .profile-wrapper {
      width: 20%;
      padding-bottom: 20%;
    }
  }

  /* Profile */
  .profile {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* LinkList */
  .link-list {
    margin: 1rem 0;
    list-style: none;
    display: flex;
    column-gap: 1rem;
    align-items: center;
    padding: 0;
  }

  .link-list li a {
    display: block;
  }

  .link-list li a:hover {
    opacity: 0.4;
  }

  /* EmailLink */
  .email-link {
    background-image: url("/email.png");
    background-size: cover;
    width: 40px;
    height: 40px;
  }

  @media (max-width: 375px) {
    .email-link {
      width: 25px;
      height: 25px;
    }
  }

  /* GithubLink */
  .github-link {
    background-image: url("/github-sign.png");
    background-size: cover;
    width: 35px;
    height: 35px;
  }

  @media (max-width: 375px) {
    .github-link {
      width: 20px;
      height: 20px;
    }
  }
</style>
