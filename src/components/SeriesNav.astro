---
import { displayTitle, postPath } from "../lib/posts";
import { getSeriesPosition } from "../lib/series";

// 시리즈에 속한 글이면 "시리즈: <이름> (n/N)"과 이전/다음 글 링크를 그린다. 아니면 아무것도 그리지 않는다.
// 순서는 src/content/series.json 이 정한다. 검증 장치의 series 검사가 nav[aria-label="시리즈"] 와 rel 을 읽는다.
interface Props {
  postId: string;
}

const { postId } = Astro.props;
const position = await getSeriesPosition(postId);
---

{position && (
  <nav class="series" aria-label="시리즈">
    <p>
      시리즈: {position.name} ({position.index + 1}/{position.total})
    </p>
    <ul>
      {position.prev && (
        <li class="prev">
          <a href={postPath(position.prev.id)} rel="prev">
            ← 이전 글: {displayTitle(position.prev)}
          </a>
        </li>
      )}
      {position.next && (
        <li class="next">
          <a href={postPath(position.next.id)} rel="next">
            다음 글: {displayTitle(position.next)} →
          </a>
        </li>
      )}
    </ul>
  </nav>
)}

<style>
  .series {
    margin: 2rem 0;
    padding: 1rem 0;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
  }

  .series p {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }

  .series ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .series .next {
    margin-left: auto;
    text-align: right;
  }

  .series a {
    text-decoration: underline;
  }
</style>
