---
import PostHeader from "../components/PostHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { displayTitle, getVisiblePosts, postPath } from "../lib/posts";
import { SITE } from "../lib/site";

// 운영 빌드에서는 발행된 글만, astro dev 에서는 "[초안]" 이 붙은 초안도 함께.
const posts = await getVisiblePosts();
---

<BaseLayout
  seo={{
    title: SITE.title,
    description: SITE.description,
    url: SITE.url,
    type: "website",
    keywords: SITE.keywords,
  }}
  home
>
  <section>
    {posts.map((post) => (
      <PostHeader
        title={displayTitle(post)}
        date={post.data.date}
        href={postPath(post.id)}
      />
    ))}
  </section>
</BaseLayout>

<style>
  /* pages/index.style.ts 의 Section */
  section {
    width: 100%;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    row-gap: 2rem;
  }

  /* 링크는 PostHeader 가 그린다. 자식 컴포넌트 안의 요소에는 스코프가 닿지 않아 :global() 로 연다. */
  section :global(a:hover) {
    text-decoration: underline;
  }
</style>
