---
import PostList from "../components/PostList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES, categoryPath } from "../lib/categories";
import { getVisiblePosts } from "../lib/posts";
import { SITE } from "../lib/site";

// 운영 빌드에서는 발행된 글만, astro dev 에서는 "[초안]" 이 붙은 초안도 함께.
const posts = await getVisiblePosts();
---

<BaseLayout
  seo={{
    title: SITE.title,
    description: SITE.description,
    url: SITE.url,
    type: "website",
    keywords: SITE.keywords,
  }}
  home
>
  <main class="page">
    {/* 카테고리로 좁혀 보기: 카테고리 페이지로 가는 링크. "전체"는 지금 이 페이지다. */}
    <nav class="filter" aria-label="카테고리로 보기">
      <ul class="pill-list">
        <li>
          <a class="tag-pill" href="/" aria-current="page">
            전체
          </a>
        </li>
        {CATEGORIES.map((category) => (
          <li>
            <a class="tag-pill" href={categoryPath(category)}>
              {category.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <PostList posts={posts} />
  </main>
</BaseLayout>
