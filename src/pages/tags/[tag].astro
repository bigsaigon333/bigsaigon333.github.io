---
// /tags/<슬러그> — 그 태그가 붙은 글, 날짜 내림차순. 항목은 홈 목록과 같은 PostHeader 다.
// 슬러그 규칙과 충돌 검사는 lib/tags.ts. params 에는 인코딩하지 않은 슬러그를 준다: Astro 가 그대로 파일 이름으로 쓴다
// (dist/tags/void-요소.html). 링크와 canonical 은 퍼센트 인코딩한 주소를 쓴다.
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import PostHeader from "../../components/PostHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { displayTitle, postPath } from "../../lib/posts";
import { SITE } from "../../lib/site";
import { getTags, TAGS_PATH, tagUrl } from "../../lib/tags";

export const getStaticPaths = (async () => {
  const tags = await getTags();

  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag } = Astro.props;
---

<BaseLayout
  seo={{
    title: `#${tag.label} | ${SITE.title}`,
    description: `"${tag.label}" 태그가 붙은 글 ${tag.posts.length}편`,
    url: tagUrl(tag.label),
    type: "website",
    keywords: [tag.label],
  }}
>
  <div class="tag-heading">
    <h2>#{tag.label}</h2>
    <a href={TAGS_PATH}>모든 태그</a>
  </div>
  <section>
    {tag.posts.map((post) => (
      <PostHeader
        title={displayTitle(post)}
        date={post.data.date}
        href={postPath(post.id)}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .tag-heading {
    width: 100%;
  }

  .tag-heading h2 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }

  .tag-heading a {
    text-decoration: underline;
  }

  /* 홈(pages/index.astro)의 목록과 같은 값 */
  section {
    width: 100%;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    row-gap: 2rem;
  }

  section :global(a:hover) {
    text-decoration: underline;
  }
</style>
