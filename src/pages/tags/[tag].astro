---
// /tags/<슬러그> — 그 태그가 붙은 글, 날짜 내림차순. 목록은 홈과 같은 PostList 다.
// 슬러그 규칙과 충돌 검사는 lib/tags.ts. params 에는 인코딩하지 않은 슬러그를 준다: Astro 가 그대로 파일 이름으로 쓴다
// (dist/tags/void-요소.html). 링크와 canonical 은 퍼센트 인코딩한 주소를 쓴다.
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../lib/site";
import { getTags, TAGS_PATH, tagUrl } from "../../lib/tags";

export const getStaticPaths = (async () => {
  const tags = await getTags();

  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag } = Astro.props;
---

<BaseLayout
  seo={{
    title: `#${tag.label} | ${SITE.title}`,
    description: `"${tag.label}" 태그가 붙은 글 ${tag.posts.length}편`,
    url: tagUrl(tag.label),
    type: "website",
    keywords: [tag.label],
  }}
>
  <div class="page-heading">
    <h2>#{tag.label}</h2>
    <p>글 {tag.posts.length}편</p>
    <a class="text-link" href={TAGS_PATH}>
      모든 태그
    </a>
  </div>
  <PostList posts={tag.posts} />
</BaseLayout>
