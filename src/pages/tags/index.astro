---
// /tags — 모든 태그와 태그마다 글 수. build.format "file" 이라 dist/tags.html 이 된다(/tags/<슬러그> 는 dist/tags/ 아래).
import TagPill from "../../components/TagPill.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../lib/site";
import { getTags, TAGS_PATH } from "../../lib/tags";

const tags = await getTags();
---

<BaseLayout
  seo={{
    title: `태그 | ${SITE.title}`,
    description: `${SITE.title}의 글에 붙은 태그 ${tags.length}개`,
    url: `${SITE.url}${TAGS_PATH}`,
    type: "website",
    keywords: tags.map((tag) => tag.label),
  }}
>
  <main class="page">
    <div class="page-heading">
      <h2>태그</h2>
      <p>태그 {tags.length}개</p>
    </div>
    <ul class="pill-list">
      {tags.map((tag) => (
        <li>
          <TagPill label={tag.label} count={tag.posts.length} />
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
