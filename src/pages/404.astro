---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/site";
---

<BaseLayout
  seo={{
    title: "404: 페이지를 찾을 수 없습니다",
    description: SITE.description,
    url: `${SITE.url}/404`,
    type: "website",
    keywords: SITE.keywords,
  }}
>
  <main>
    <p>요청하신 페이지를 찾을 수 없습니다.</p>
    <a href="/">홈으로 돌아가기</a>
  </main>
</BaseLayout>
