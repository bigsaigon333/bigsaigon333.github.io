---
// dist/404.html 이 된다. GitHub Pages 는 없는 경로 어디에서든 이 파일을 404 상태로 돌려준다.
// 어느 깊이의 URL 에서 열릴지 모르므로 이 페이지의 링크와 자산 경로는 모두 "/" 로 시작해야 한다.
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/site";
---

<BaseLayout
  seo={{
    title: "404: 페이지를 찾을 수 없습니다",
    description: SITE.description,
    url: `${SITE.url}/404`,
    type: "website",
    keywords: SITE.keywords,
    // /404 와 /404.html 은 직접 열면 200 으로 응답한다. 검색 결과에 실리지 않게 한다.
    noindex: true,
  }}
>
  <main class="page-heading">
    <h2>페이지를 찾을 수 없습니다</h2>
    <p>주소가 바뀌었거나 없는 글입니다.</p>
    <a class="text-link" href="/">
      홈으로 돌아가기
    </a>
  </main>
</BaseLayout>

<style>
  /* 레이아웃의 세로 flex 안에서 남는 높이를 채워 푸터를 바닥에 둔다. */
  main {
    flex-grow: 1;
  }
</style>
