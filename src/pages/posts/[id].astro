---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";

import Comments from "../../components/Comments.astro";
import CopyCode from "../../components/CopyCode.astro";
import PostHeader from "../../components/PostHeader.astro";
import PostTags from "../../components/PostTags.astro";
import SeriesNav from "../../components/SeriesNav.astro";
import Toc from "../../components/Toc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  displayTitle,
  getVisiblePosts,
  isDraft,
  postUrl,
} from "../../lib/posts";

// 글 페이지에만 실리는 전역 CSS 두 개. 이 페이지만 import 하므로 홈과 404 에는 나가지 않는다.
// 다른 import 뒤에 둔다. 이 둘은 한 묶음이 되고, 묶음은 그 안에서 가장 먼저 import 된 파일의 자리에 놓인다.
// 하나라도 맨 위로 올리면 둘 다 global.css 앞으로 가서, 특이도가 같은 규칙에서 전역 스타일에 지게 된다.
//
// 1. 코드 블록의 색: Shiki 가 붙인 CSS 변수 중 라이트·다크 어느 쪽을 쓸지 정한다.
import "../../styles/code.css";
// 2. 본문(<main class="prose"> 아래): <Content /> 가 그린 요소에는 scoped <style> 이 닿지 않아 전역 CSS 로 둔다.
import "../../styles/prose.css";

// 운영 빌드에서는 발행된 글만, astro dev 에서는 초안도(lib/posts.ts 의 getVisiblePosts).
export const getStaticPaths = (async () => {
  const posts = await getVisiblePosts();

  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { title, date, description, keywords } = post.data;
const { Content, headings } = await render(post);
---

<BaseLayout
  seo={{
    // 제목 뒤에 아무것도 붙이지 않는다. utterances 가 문서 제목으로 댓글 이슈를 찾는다.
    title,
    description,
    // build.format "file" 에서는 Astro.url.pathname 이 ".html" 로 끝난다. canonical 은 id 로 조립한다.
    url: postUrl(post.id),
    type: "article",
    keywords,
    publishedTime: date,
  }}
>
  <PostHeader title={displayTitle(post)} date={date} />
  <PostTags keywords={keywords} />
  <Toc headings={headings} />
  {/* 코드 블록마다 복사 버튼(S6.3). 상자 없는 <copy-code hidden> 이다. <main> 뒤에 두면 utterances 의 자리(main 바로 뒤)가 바뀐다. */}
  <CopyCode />
  <main class="prose">
    <Content />
  </main>
  <SeriesNav postId={post.id} />
  {
    // 초안(dev 에서만 그려진다)에는 댓글을 싣지 않는다. utterances 가 초안 제목으로 이슈를 만들면 안 된다.
    !isDraft(post) && <Comments />
  }
</BaseLayout>
